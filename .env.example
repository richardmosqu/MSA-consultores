# Copia este archivo a .env para desarrollo local.

# Base de datos (en Railway: referencia a la variable DATABASE_URL del servicio Postgres)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/msa

# Secreto de Payload: una cadena larga y aleatoria (openssl rand -hex 32). Distinto en cada entorno.
PAYLOAD_SECRET=

# URL pública del sitio (sin barra final). Ej.: https://msaconsultores.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Imágenes en Cloudflare R2 (o cualquier S3 compatible). Si se deja vacío, se guardan en disco (solo desarrollo).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Aviso por correo de los mensajes del formulario (Resend). Opcional: sin clave, los mensajes igual quedan en el panel.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Sitio MSA <web@msaconsultores.com>

# Solo para `pnpm seed` en local: crea un usuario administrador.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
